{
  "name": "appium-wincore-driver",
  "version": "4.0.0-beta.2",
  "description": "Appium driver for Windows",
  "keywords": [
    "appium",
    "automated testing",
    "desktop",
    "desktop automation",
    "uiautomation",
    "verisoft",
    "wincore",
    "windows"
  ],
  "bugs": {
    "url": "https://github.com/appium/appium-wincore-driver/issues"
  },
  "license": "Apache-2.0",
  "author": "verisoft-ai",
  "contributors": [
    "Yuri Schwab (https://github.com/y-schwab)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-wincore-driver.git"
  },
  "files": [
    "build/lib/**/*",
    "iebridge/IEBridge.exe",
    "native/win-x64/WincoreServer.exe",
    "scripts/postinstall.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "build:native": "dotnet publish csharp/WincoreServer/WincoreServer.csproj -c Release -o native/win-x64/",
    "build:iebridge": "dotnet publish csharp/IEBridge/IEBridge.csproj -r win-x86 -c Release -o iebridge/x86 && node -e \"const fs=require('fs');fs.copyFileSync('iebridge/x86/IEBridge.exe','iebridge/IEBridge.exe');\"",
    "build:all": "npm run build:native && npm run build:iebridge && npm run build",
    "watch": "tsc -b --watch",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "test": "npm run build && node --enable-source-maps --experimental-test-module-mocks --test --test-timeout=60000 \"build/test/**/*.test.js\"",
    "test:e2e": "npm run build && node --enable-source-maps --test --test-concurrency=1 --test-timeout=60000 \"build/test/e2e/**/*.e2e.js\"",
    "test:perf": "npm run build && node --enable-source-maps --test --test-concurrency=1 --test-timeout=900000 \"build/test/perf/**/*.perf.js\"",
    "postinstall": "node scripts/postinstall.mjs",
    "pack:dist": "node scripts/pack-dist.mjs"
  },
  "dependencies": {
    "@appium/css-locator-to-native": "^1.0.6",
    "appium-chromedriver": "^8.3.1",
    "asyncbox": "^6.3.5",
    "bezier-easing": "^2.1.0",
    "koffi": "^2.14.1"
  },
  "devDependencies": {
    "@appium/oxc-config": "^2.0.0-beta.1",
    "@appium/semantic-release-config": "^2.0.0-beta.1",
    "@appium/tsconfig": "^2.0.0-beta.1",
    "@appium/types": "^2.0.0-beta.2",
    "@types/node": "^24.8.1",
    "webdriverio": "^9.30.1"
  },
  "peerDependencies": {
    "appium": "^4.0.0-beta.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "appium": {
    "driverName": "wincore",
    "automationName": "Wincore",
    "platformNames": [
      "Windows"
    ],
    "mainClass": "AppiumWincoreDriver"
  }
}
